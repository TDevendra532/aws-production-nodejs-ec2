###############################################################################
# Production environment — full HA and observability
# Copy to terraform.tfvars and fill in real values
###############################################################################

environment = "production"
project     = "nodejs-api"
region      = "ap-south-1"

# Networking
vpc_cidr          = "10.0.0.0/16"
azs               = ["ap-south-1a", "ap-south-1b"]
nat_gateway_count = 2   # HA — one NAT per AZ

# Compute
instance_type    = "t3.medium"
min_size         = 2
desired_capacity = 2
max_size         = 6
target_cpu       = 60

# Observability
log_retention_days = {
  app_nodejs    = 30
  system_syslog = 14
  flow_logs     = 30
  waf_logs      = 90
}

# Domain
domain_name = "api.example.com"

# Tags
common_tags = {
  Environment = "production"
  Project     = "nodejs-api"
  Owner       = "sre-team"
  CostCenter  = "engineering"
  ManagedBy   = "terraform"
}
